# 复制成 .env 后按需修改：  cp .env.example .env

# 镜像标签。可以用 latest，也可以钉死某个版本，例如 zip2609.001
YC7ZIP_TAG=latest

# 对外端口
YC7ZIP_PORT=8090

# 要操作的目录：NAS 上的真实路径 -> 挂进容器的 /share
# 例如 YC7ZIP_SHARE=/vol1/1000
YC7ZIP_SHARE=./share

# 允许读写的路径（容器内路径，逗号分隔）
YC7ZIP_ALLOW_ROOTS=/share

# 工作区落盘位置（宿主机路径）
YC7ZIP_DATA=./data

# HTTP Basic 认证，留空表示不启用。从外网访问时务必设置。
YC7ZIP_AUTH=

# 单任务上传上限
YC7ZIP_MAX_UPLOAD=4G

# 时区
TZ=Asia/Shanghai
