#!/bin/bash
# YC-7ZIP 生命周期入口。start/stop 交给应用中心处理 Docker，这里只负责状态查询。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

container_name () {
    [ -f "$FILE_PATH" ] && grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs
}

is_running () {
    name=$(container_name)
    [ -z "$name" ] && return 1
    docker inspect "$name" 2>/dev/null | grep -q '"Status": "running",'
}

case $1 in
start)
    # Docker 应用由应用中心负责启动
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    # 0 = 运行中，3 = 未运行
    if is_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
